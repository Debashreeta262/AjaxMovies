# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/employee_portal

# Long random string used to sign JWTs — change this
JWT_SECRET=replace_this_with_a_long_random_string

# Token lifetime
JWT_EXPIRES_IN=8h

# Server port
PORT=5000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# One-time bootstrap admin, used only by `npm run seed`
SEED_ADMIN_NAME=Company Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
